[user]
	email = theo.benoit16@gmail.com
	name = Androlax2
[core]
	autocrlf = input
	excludesfile = /home/theo/.gitignore_global
[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
[credential]
	helper = store
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	syntax-theme = tokyonight_night
[include]
	path = ~/.config/delta/tokyonight_night.gitconfig
