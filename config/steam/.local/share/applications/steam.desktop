[Desktop Entry]
# Overrides /usr/share/applications/steam.desktop: Steam and the games it starts get MangoHud
# (hidden until Left Shift + F12, ~/.config/MangoHud/MangoHud.conf); no other program loads it.
Name=Steam
Comment=Application for managing and playing games on Steam
Exec=env MANGOHUD=1 /usr/bin/steam %U
Icon=steam
Terminal=false
Type=Application
Categories=Network;FileTransfer;Game;
MimeType=x-scheme-handler/steam;x-scheme-handler/steamlink;
PrefersNonDefaultGPU=true
X-KDE-RunOnDiscreteGpu=true
