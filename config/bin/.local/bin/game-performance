#!/usr/bin/env bash
# While a game runs, the rest of the machine steps aside. Feral GameMode runs this at the start and
# the end of a game (~/.config/gamemode.ini, [custom]); GameMode itself switches the CPU and GPU to
# their performance modes.
#
#   game-performance on    freeze the agent sandboxes, pause the heavy timers, drop the remaining
#                          background work to idle CPU and disk priority
#   game-performance off   undo it: sandboxes thawed (they carry on where they stopped), priorities
#                          back, the paused timers restarted (one that came due meanwhile runs now),
#                          Hyprland's game mode off
#
# Only timers that were running are restarted, from the list kept in $XDG_RUNTIME_DIR.
set -uo pipefail

# Heavy or long jobs that can wait for the end of a game.
PAUSED_TIMERS=(restic-backup.timer restic-maintenance.timer jobpilot-apply.timer update-check.timer
               security-check.timer claude-health-check.timer)
# The agent sandboxes: every agent (Claude Code, opencode, codex) runs under greywall, in the systemd
# scope of the terminal that started it (tmux-spawn-*.scope for a tmux pane, kitty-*.scope for a
# kitty window), and that scope holds everything it runs (the agent, its builds and tests). Those
# scopes are frozen (cgroup freezer), not killed: the sessions resume mid-step after the game. The
# column and approval panes have no greywall in their scope and stay usable.
FROZEN_LIST="${XDG_RUNTIME_DIR:-/tmp}/game-performance.frozen"
# Jobs of the timers above that may already be running when the game starts.
LOWERED_UNITS=(restic-backup.service restic-maintenance.service jobpilot-apply.service
               update-check.service security-check.service claude-health-check.service)
PAUSED_LIST="${XDG_RUNTIME_DIR:-/tmp}/game-performance.paused"

# The systemd units (scopes) of the running greywall sandboxes, one per line.
sandbox_scopes() {
    ps -C greywall -o cgroup= 2>/dev/null | sed -n 's|.*/\([^/]*\.scope\)$|\1|p' | sort -u
}

log() { # message [level]
    claude-sessions log game "${2:-INFO}" "$1" 2>/dev/null || true
}

# The running Hyprland's instance. GameMode runs this from its own service, which keeps the
# HYPRLAND_INSTANCE_SIGNATURE of the session it started in, and outlives a Hyprland restart: then
# the newest instance with a live socket is the one.
hyprland_instance() {
    local base="${XDG_RUNTIME_DIR:-/tmp}/hypr" instance
    if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} && -e $base/$HYPRLAND_INSTANCE_SIGNATURE/.socket.sock ]]; then
        echo "$HYPRLAND_INSTANCE_SIGNATURE"
        return
    fi
    instance=$(ls -t "$base" 2>/dev/null | while read -r instance; do
        [[ -e $base/$instance/.socket.sock ]] && { echo "$instance"; break; }
    done)
    echo "$instance"
}

on() {
    : > "$PAUSED_LIST"
    local timer unit
    for timer in "${PAUSED_TIMERS[@]}"; do
        if systemctl --user is-active --quiet "$timer"; then
            systemctl --user stop "$timer" && echo "$timer" >> "$PAUSED_LIST"
        fi
    done
    for unit in "${LOWERED_UNITS[@]}"; do
        systemctl --user set-property --runtime "$unit" CPUWeight=idle IOWeight=1 2>/dev/null || true
    done
    : > "$FROZEN_LIST"
    local scope
    # The setting freeze-while-gaming (the cockpit's S); an unreadable answer freezes, as before.
    if [[ $(claude-sessions setting freeze-while-gaming 2>/dev/null) == *": off" ]]; then
        log "freeze-while-gaming is off: the agent sandboxes keep running"
    else
        while read -r scope; do
            [[ -n $scope ]] && systemctl --user freeze "$scope" 2>/dev/null && echo "$scope" >> "$FROZEN_LIST"
        done < <(sandbox_scopes)
    fi
    log "game started: $(wc -l < "$FROZEN_LIST") agent sandbox(es) paused, $(wc -l < "$PAUSED_LIST") timer(s) paused, background work at idle priority"
}

off() {
    local unit timer scope
    if [[ -f $FROZEN_LIST ]]; then
        while read -r scope; do
            [[ -n $scope ]] && systemctl --user thaw "$scope" 2>/dev/null
        done < "$FROZEN_LIST"
        rm -f "$FROZEN_LIST"
    fi
    for unit in "${LOWERED_UNITS[@]}"; do
        # An empty assignment puts the unit's own setting back.
        systemctl --user set-property --runtime "$unit" CPUWeight= IOWeight= 2>/dev/null || true
    done
    if [[ -f $PAUSED_LIST ]]; then
        while read -r timer; do
            [[ -n $timer ]] && systemctl --user start "$timer"
        done < "$PAUSED_LIST"
        rm -f "$PAUSED_LIST"
    fi
    # Hyprland's game mode (eye candy, the gamemode submap) goes with the game; a failure says so in
    # the log, where a silent one left game mode on.
    if ! HYPRLAND_INSTANCE_SIGNATURE=$(hyprland_instance) hyprctl eval "EXIT_GAME_MODE()" >/dev/null 2>&1; then
        log "game ended, but Hyprland could not be told to leave game mode (ALT + G leaves it)" WARN
    fi
    log "game ended: agent sandboxes resumed, background work back to normal"
}

case "${1:-}" in
    on) on ;;
    off) off ;;
    *) echo "usage: game-performance on|off" >&2; exit 2 ;;
esac
