# Generated from templates (contains secrets)
config/wireplumber/.config/wireplumber/wireplumber.conf.d/60-airpods-priority.conf

# Rewritten by wallpaper-rotator.sh every 30 minutes
config/hyprland/.config/hypr/wallpaper.conf

# Rewritten by the file manager; a tracked copy kept blocking the apply
config/gtk/.config/gtk-3.0/bookmarks

# Security baseline of this machine (ports, users, SUID files, SSH key fingerprints):
# generated by `make dump-security`, kept local
security/

# OpenRGB device enumeration logs (USB paths, serial numbers)
config/OpenRGB/.config/OpenRGB/logs/

# Commits the dotfiles session exports for cockpit apply (in its work clone)
.outgoing/

# IntelliJ project files
.idea/

# Python bytecode caches: rewritten whenever a script runs (the vendored modules of NSLGameScanner)
__pycache__/

# Claude Code's per-machine permissions for this folder (written by Claude, never shared)
.claude/settings.local.json
