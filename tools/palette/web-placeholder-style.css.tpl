/* Generated by tools/palette.sh from config/waybar/.config/waybar/colors.css; edit tools/palette/web-placeholder-style.css.tpl instead. */
/* Loading placeholder of the web scratchpads (~/.config/hypr/scripts/web-placeholder.py). */
@define-color ground {{ground}};
@define-color comment {{comment}};
@define-color blue {{blue}};

window.web-placeholder,
window.web-placeholder.background {
    background: @ground;
}

window.web-placeholder spinner {
    color: @blue;
    min-width: 40px;
    min-height: 40px;
}

window.web-placeholder .title {
    color: @comment;
    font-family: "SF Pro Text", sans-serif;
    font-size: 15px;
}
