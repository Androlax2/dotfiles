/* Generated by tools/palette.sh from config/waybar/.config/waybar/colors.css; edit tools/palette/claude-idle-style.css.tpl instead. */
/* The "still there?" screen of the Claude workspace (~/.config/hypr/scripts/claude-idle-prompt.py). */
@define-color ground {{ground}};
@define-color line {{line}};
@define-color fg {{fg}};
@define-color comment {{comment}};
@define-color red {{red}};

window.claude-idle,
window.claude-idle.background {
    background: alpha(@ground, 0.55);
}

window.claude-idle .card {
    background: @ground;
    border: 1px solid @line;
    border-radius: 18px;
    padding: 40px 64px;
}

window.claude-idle .countdown {
    color: @red;
    font-family: "SF Pro Display", sans-serif;
    font-size: 64px;
    font-weight: 700;
}

window.claude-idle .title {
    color: @fg;
    font-family: "SF Pro Display", sans-serif;
    font-size: 26px;
    font-weight: 600;
}

window.claude-idle .hint {
    color: @comment;
    font-family: "SF Pro Text", sans-serif;
    font-size: 15px;
}
